{
  "mcp_servers": {
    "minecraft-wiki-mcp": {
      "command": "uv",
      "args": [
        "--directory", "/path/to/Minecraft-Wiki-MCP",
        "run", "minecraft-wiki-mcp"
      ],
      "env": {
        "MINECRAFT_WIKI_API_URL": "https://zh.minecraft.wiki/api.php",
        "MINECRAFT_WIKI_TRANSPORT": "stdio"
      }
    },
    "mc-wiki-fetch-mcp": {
      "command": "uvx",
      "args": ["mc-wiki-fetch-mcp"],
      "env": {
        "MC_WIKI_API_BASE_URL": "https://mcwiki.rice-awa.top"
      }
    }
  }
}
